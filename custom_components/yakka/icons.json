{
  "entity": {
    "button": {
      "complete": {
        "default": "mdi:check-circle-outline"
      }
    },
    "sensor": {
      "status": {
        "default": "mdi:broom",
        "state": {
          "upcoming": "mdi:calendar-clock",
          "due": "mdi:bell-ring-outline",
          "overdue": "mdi:alert-circle-outline",
          "done": "mdi:check-circle",
          "unscheduled": "mdi:calendar-blank-outline"
        }
      },
      "next_due": {
        "default": "mdi:calendar-clock"
      },
      "last_completed": {
        "default": "mdi:history"
      },
      "assignee": {
        "default": "mdi:account-arrow-right"
      },
      "due_chores": {
        "default": "mdi:bell-ring-outline"
      },
      "overdue_chores": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "todo": {
      "chores": {
        "default": "mdi:broom"
      }
    }
  },
  "services": {
    "complete_chore": {
      "service": "mdi:check-circle-outline"
    },
    "undo_completion": {
      "service": "mdi:undo"
    }
  },
  "triggers": {
    "chore_completed": {
      "trigger": "mdi:check-circle"
    },
    "chore_undone": {
      "trigger": "mdi:undo"
    },
    "chore_due": {
      "trigger": "mdi:bell-ring-outline"
    },
    "chore_overdue": {
      "trigger": "mdi:alert-circle-outline"
    }
  },
  "conditions": {
    "chore_is_due": {
      "condition": "mdi:bell-ring-outline"
    },
    "chore_is_overdue": {
      "condition": "mdi:alert-circle-outline"
    },
    "chore_is_not_due": {
      "condition": "mdi:calendar-check"
    },
    "chore_completed_by": {
      "condition": "mdi:account-check"
    }
  }
}
